# The probe appends to these every run. Git cannot auto-merge them line-wise by
# default, which turns any local commit into a conflict. "union" is a built-in
# merge driver that keeps both sides' lines, which is exactly right for
# append-only logs.
data/*.jsonl merge=union
data/*.csv   merge=union

# Line endings, scoped to source files only. Deliberately NOT "* text=auto",
# because that would renormalise the large captured JSON files and produce a
# huge meaningless diff.
*.py  text eol=lf
*.yml text eol=lf
*.md  text eol=lf
*.txt text eol=lf
